# ====================
# DJANGO CORE SETTINGS
# ====================
DEBUG=True
APP_ENV=development
SECRET_KEY=your-production-secret-key-change-this-now
DJANGO_SETTINGS_MODULE=backend.settings
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://azu.rassokha.pro
FRONTEND_URL=http://localhost:3000
# CORS — Frontend domen
# DEV:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://azu.rassokha.pro
# PRODUCTION:
# CORS_ALLOWED_ORIGINS=https://ambasada.rs,https://www.ambasada.rs

# ====================
# DATABASE
# ====================
ENABLE_POSTGRES_DB=True
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=_CHANGEME_
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Used by `pg_isready`:
PGUSER=postgres

# ====================
# REDIS & CACHE
# ====================
REDIS_URL=redis://redis:6379/0
CACHE_LOCATION=redis://redis:6379/

# ====================
# CELERY
# ====================
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/
CELERY_TIMEZONE=Europe/Moscow

# ====================
# EMAIL
# ====================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@myproject.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# ====================
# CADDY WEBSERVER
# ====================
CADDY_DOMAIN_NAME=mydomain.ru
CADDY_LETSENCRYPT_EMAIL=some@email.com.no
