# ====================
# DJANGO CORE SETTINGS
# ====================
DEBUG=True
APP_ENV=development
SECRET_KEY=your-production-secret-key-change-this-now
DJANGO_SETTINGS_MODULE=backend.settings
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://azu.rassokha.pro
# CORS — Frontend domen
# DEV:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://azu.rassokha.pro
# PRODUCTION:
# CORS_ALLOWED_ORIGINS=https://ambasada.rs,https://www.ambasada.rs

# ====================
# DATABASE
# ====================
ENABLE_POSTGRES_DB=True
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=_CHANGEME_
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Used by `pg_isready`:
PGUSER=postgres

# ====================
# REDIS & CACHE
# ====================
REDIS_URL=redis://redis:6379/0
CACHE_LOCATION=redis://redis:6379/

# ====================
# CELERY
# ====================
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/
CELERY_TIMEZONE=Europe/Moscow

# ====================
# EMAIL
# ====================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@myproject.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# ====================
# CADDY WEBSERVER
# ====================
CADDY_DOMAIN_NAME=mydomain.ru
CADDY_LETSENCRYPT_EMAIL=some@email.com.no

# ====================
# SECURITY SETTINGS
# ====================
# JWT Token Lifetime (minutes)
JWT_ACCESS_TOKEN_MINUTES=60
# JWT Refresh Token Lifetime (days)
JWT_REFRESH_TOKEN_DAYS=1

# ====================
# PRODUCTION PATHS
# ====================
# Production paths (only used when APP_ENV=production)
PRODUCTION_MEDIA_ROOT=/var/www/django/media

# ====================
# THROTTLING RATES
# ====================
# Rate limits for API endpoints
THROTTLE_RATE_ANON=120/hour
THROTTLE_RATE_USER=600/hour
THROTTLE_RATE_CONTACT=5/hour
THROTTLE_RATE_AUTH=10/minute

# ====================
# LOGGING
# ====================
# Path for log files
LOG_FILE_PATH=debug.log

# ====================
# DJANGO SUPERUSER
# ====================
# Credentials for automatic superuser creation in production
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_IN_PRODUCTION
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=Adminov

# ====================
# GUNICORN SETTINGS
# ====================
# Gunicorn server configuration
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=400

# ====================
# ADMIN LOGIN THROTTLE
# ====================
# Rate limiting for admin login brute-force protection
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_SECONDS=60
ADMIN_LOGIN_BLOCK_SECONDS=300

# ====================
# CADDY RATE LIMITING
# ====================
# Rate limiting for reverse proxy
CADDY_RATE_STATIC_EVENTS=500
CADDY_RATE_STATIC_WINDOW=10s
CADDY_RATE_DYNAMIC_EVENTS=300
CADDY_RATE_DYNAMIC_WINDOW=3s

# ====================
# COOKIE NAMES
# ====================
# Security cookie names
SESSION_COOKIE_NAME=ambasada_sessionid
CSRF_COOKIE_NAME=ambasada_csrftoken
